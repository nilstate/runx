{
  "schema": "runx.tool.manifest.v1",
  "name": "acme.echo",
  "source": {
    "type": "cli-tool",
    "command": "sh",
    "args": [
      "-c",
      "printf '{\"message\":\"%s\",\"cwd\":\"%s\"}\\n' \"$RUNX_INPUT_MESSAGE\" \"$RUNX_CWD\""
    ]
  },
  "inputs": {
    "message": {
      "type": "string",
      "required": true
    }
  }
}
