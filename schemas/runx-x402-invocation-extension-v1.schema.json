          "$id": "https://schemas.runx.ai/runx/payment/offer-revision-ref/v1.json",
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "input_schema_digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "offer_id": {
              "minLength": 1,
              "type": "string"
            },
            "output_schema_digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "revision": {
              "minLength": 1,
              "type": "string"
            },
            "revision_digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "schema": {
              "const": "runx.payment.offer_revision_ref.v1",
              "type": "string"
            }
          },
          "required": [
            "offer_id",
            "revision",
            "revision_digest",
            "input_schema_digest",
            "output_schema_digest"
          ],
          "type": "object",
          "x-runx-schema": "runx.payment.offer_revision_ref.v1"
        },
        "package_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "purpose": {
          "const": "discovery",
          "type": "string"
        }
      },
      "required": [
        "purpose",
        "offer_revision",
        "package_digest"
      ],
      "type": "object"
