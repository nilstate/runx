{
  "$id": "https://schemas.runx.ai/runx/payment/charge-verification-request/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "credential_binding": {
      "additionalProperties": false,
      "properties": {
        "credential_ref": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "family": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "family",
        "credential_ref"
      ],
      "type": "object"
    },
    "forwarding_status": {
      "anyOf": [
        {
          "const": "not_forwarded",
          "type": "string"
        }
      ]
    },
    "open_questions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "message": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "provider_status": {
      "anyOf": [
        {
          "const": "not_called",
          "type": "string"
        }
      ]
    },
    "receipt_status": {
      "anyOf": [
        {
          "const": "not_sealed",
          "type": "string"
        }
      ]
    },
    "schema": {
      "const": "runx.payment.charge_verification_request.v1",
      "type": "string"
    },
    "verification_request": {
      "additionalProperties": false,
      "properties": {
        "challenge_id": {
          "minLength": 1,
          "type": "string"
        },
        "credential_ref": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision": {
          "anyOf": [
            {
              "const": "ready_for_provider_adapter",
              "type": "string"
            },
            {
              "const": "blocked",
              "type": "string"
            }
          ]
        },
        "idempotency": {
          "additionalProperties": false,
          "properties": {
            "key": {
              "minLength": 1,
              "type": "string"
            },
            "replay_policy": {
              "anyOf": [
                {
                  "const": "recover_or_refuse_duplicate",
                  "type": "string"
                }
              ]
            }
          },
          "required": [
            "key",
            "replay_policy"
          ],
          "type": "object"
        },
        "price_id": {
          "minLength": 1,
          "type": "string"
        },
        "request_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "settlement_family": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "verify_capability_ref": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "price_id",
        "challenge_id",
        "settlement_family",
        "credential_ref",
        "verify_capability_ref",
        "idempotency",
        "decision",
        "request_digest"
      ],
      "type": "object"
    }
  },
  "required": [
    "verification_request",
    "credential_binding",
    "provider_status",
    "receipt_status",
    "forwarding_status",
    "open_questions"
  ],
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.payment.charge_verification_request.v1"
}
