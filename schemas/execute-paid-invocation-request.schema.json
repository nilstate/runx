          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "type",
        "uri"
      ],
      "type": "object",
      "x-runx-schema": "runx.reference.v1"
    },
    "schema": {
      "const": "runx.payment.execute_paid_invocation.request.v1",
      "type": "string"
    },
    "settlement_family": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "type": "string"
    }
  },
  "required": [
    "invocation_id",
    "settlement_family",
    "payment_ref",
    "idempotency"
  ],
  "type": "object",
  "x-runx-packet": true,
  "x-runx-schema": "runx.payment.execute_paid_invocation.request.v1"
}
