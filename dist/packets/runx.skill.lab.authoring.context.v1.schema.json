{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/skill_lab/authoring_context/v1.json",
  "x-runx-packet-id": "runx.skill_lab.authoring_context.v1",
  "type": "object",
  "required": [
    "repo_root",
    "target_dir",
    "target_exists",
    "base_digest",
    "target_files",
    "target_metrics",
    "catalog_root",
    "catalog_skills",
    "core_tools"
  ],
  "properties": {
    "repo_root": { "type": "string", "minLength": 1 },
    "target_dir": { "type": ["string", "null"] },
    "target_exists": { "type": "boolean" },
    "base_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "target_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "bytes"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "target_metrics": {
      "type": "object",
      "required": [
        "files",
        "bytes",
        "text_lines",
        "production_lines",
        "test_lines",
        "generated_lines",
        "executable_files",
        "executable_lines"
      ],
      "properties": {
        "files": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 },
        "text_lines": { "type": "integer", "minimum": 0 },
        "production_lines": { "type": "integer", "minimum": 0 },
        "test_lines": { "type": "integer", "minimum": 0 },
        "generated_lines": { "type": "integer", "minimum": 0 },
        "executable_files": { "type": "integer", "minimum": 0 },
        "executable_lines": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "catalog_root": { "type": "string", "minLength": 1 },
    "catalog_skills": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "core_tools": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
  },
  "additionalProperties": false
}
