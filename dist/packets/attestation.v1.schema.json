{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/attestation/v1.json",
  "x-runx-packet-id": "runx.attestation.v1",
  "type": "object",
  "required": ["schema", "decision", "action", "claim", "principal", "evidence_refs", "scope", "attestation_digest", "gaps", "proof_boundary"],
  "properties": {
    "schema": { "const": "runx.attestation.v1" },
    "decision": {
      "type": "string",
      "enum": ["ready_to_seal", "needs_more_evidence", "needs_agent"]
    },
    "action": { "type": "string", "maxLength": 2000 },
    "claim": { "type": "string", "maxLength": 4000 },
    "principal": { "type": "string", "maxLength": 512 },
    "evidence_refs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["ref", "digest", "proves"],
        "properties": {
          "ref": { "type": "string", "maxLength": 512 },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "proves": { "type": "string", "maxLength": 1000 }
        },
        "additionalProperties": false
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": true
    },
    "attestation_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "proof_boundary": {
      "type": "object",
      "required": ["external_action_verified", "provider_status", "external_ledger_status", "runtime_seal_status"],
      "properties": {
        "external_action_verified": { "const": false },
        "provider_status": { "const": "not_called" },
        "external_ledger_status": { "const": "not_requested" },
        "runtime_seal_status": { "const": "pending_parent_receipt" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
