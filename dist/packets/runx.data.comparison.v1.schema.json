{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/data/comparison/v1.json",
  "x-runx-packet-id": "runx.data.comparison.v1",
  "type": "object",
  "required": ["equal", "actual_digest", "expected_digest"],
  "properties": {
    "equal": { "type": "boolean" },
    "actual_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "expected_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
