{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/unseal/v1.json",
  "x-runx-packet-id": "runx.unseal.v1",
  "type": "object",
  "required": [
    "schema",
    "decision",
    "secret_ref",
    "purpose",
    "ttl",
    "ttl_minutes",
    "scope",
    "principal",
    "gates",
    "blockers",
    "execution",
    "downstream_handoff",
    "policy_notes"
  ],
  "properties": {
    "schema": { "const": "runx.unseal.v1" },
    "decision": {
      "type": "string",
      "enum": ["ready_for_approval", "needs_input", "refused"]
    },
    "secret_ref": { "type": "string" },
    "purpose": { "type": "string" },
    "ttl": { "type": "string" },
    "ttl_minutes": { "type": "integer", "minimum": 0, "maximum": 60 },
    "scope": { "type": "object", "additionalProperties": true },
    "principal": { "type": "string" },
    "gates": {
      "type": "object",
      "required": ["human_approval_required", "approval_ref"],
      "properties": {
        "human_approval_required": { "const": true },
        "approval_ref": { "type": "string" }
      },
      "additionalProperties": false
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "execution": {
      "type": "object",
      "required": [
        "requires_adapter",
        "requires_approval",
        "provider_status",
        "handle_issued",
        "secret_material_exposed"
      ],
      "properties": {
        "requires_adapter": { "const": true },
        "requires_approval": { "const": true },
        "provider_status": { "const": "not_called" },
        "handle_issued": { "const": false },
        "secret_material_exposed": { "const": false }
      },
      "additionalProperties": false
    },
    "downstream_handoff": {
      "type": "object",
      "properties": {
        "skill": { "const": "vault-unseal" },
        "runner": { "const": "execute" },
        "state": { "const": "ready_for_approval" }
      },
      "additionalProperties": false
    },
    "policy_notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "ready_for_approval" } } },
      "then": {
        "properties": {
          "secret_ref": { "minLength": 1 },
          "purpose": { "minLength": 1 },
          "ttl_minutes": { "minimum": 1 },
          "principal": { "minLength": 1 },
          "blockers": { "maxItems": 0 },
          "downstream_handoff": { "required": ["skill", "runner", "state"] }
        }
      },
      "else": {
        "properties": {
          "blockers": { "minItems": 1 },
          "downstream_handoff": { "maxProperties": 0 }
        }
      }
    }
  ],
  "additionalProperties": false
}
