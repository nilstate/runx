{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/issue/triage-queue/v1.json",
  "x-runx-packet-id": "runx.issue.triage_queue.v1",
  "type": "object",
  "required": ["schema", "decision", "query", "issue_candidates", "selection_rationale", "evidence_refs", "provider_status"],
  "properties": {
    "schema": { "const": "runx.issue.triage_queue.v1" },
    "decision": { "const": "ready" },
    "query": { "type": "string", "minLength": 1 },
    "issue_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "reason", "source_ref"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "source_ref": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "selection_rationale": {
      "type": "object",
      "properties": {
        "chosen_issue": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "evidence_refs": { "type": "array", "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } },
    "provider_status": { "type": "string", "enum": ["readback", "supplied_snapshot"] }
  },
  "additionalProperties": false
}
