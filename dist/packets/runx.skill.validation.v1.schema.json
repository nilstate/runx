{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/skill/validation/v1.json",
  "x-runx-packet-id": "runx.skill.validation.v1",
  "type": "object",
  "required": ["schema", "requested_ref", "resolved_ref", "verdict", "inspect", "harness"],
  "properties": {
    "schema": { "const": "runx.skill.validation.v1" },
    "requested_ref": { "type": "string", "minLength": 1 },
    "resolved_ref": { "type": "string", "minLength": 1 },
    "verdict": { "enum": ["tested", "needs_consequential_harness_approval", "validation_failed"] },
    "inspect": { "type": "object", "additionalProperties": true },
    "harness": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}
