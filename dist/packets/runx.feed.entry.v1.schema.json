{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/feed-entry/v1.json",
  "x-runx-packet-id": "runx.feed_entry.v1",
  "$defs": {
    "milestone": {
      "type": "object",
      "required": [
        "kind",
        "status",
        "summary"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "accepted",
            "triaged",
            "spec_ready",
            "build_started",
            "review_requested",
            "change_request_created",
            "human_gate",
            "final_outcome"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "failed",
            "passed",
            "pending",
            "ready"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "feedEntry": {
      "type": "object",
      "required": [
        "thread_locator",
        "title",
        "next_action",
        "milestones"
      ],
      "properties": {
        "thread_locator": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "milestones": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/milestone"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schema",
    "data"
  ],
  "properties": {
    "schema": {
      "const": "runx.feed_entry.v1"
    },
    "data": {
      "$ref": "#/$defs/feedEntry"
    }
  },
  "additionalProperties": false
}
