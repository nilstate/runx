{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/provider/operation/v1.json",
  "x-runx-packet-id": "runx.provider.operation.v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "access",
    "principal_ref",
    "grant_ref",
    "provider",
    "operation",
    "result"
  ],
  "properties": {
    "schema": { "const": "runx.provider.operation.v1" },
    "status": { "const": "success" },
    "access": { "enum": ["read", "mutate"] },
    "principal_ref": {
      "type": "string",
      "pattern": "^runx:principal:.+$"
    },
    "grant_ref": {
      "type": "string",
      "pattern": "^runx:grant:.+$"
    },
    "provider": { "type": "string", "minLength": 1 },
    "operation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"
    },
    "result": {},
    "operation_id": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "readback_ref": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
