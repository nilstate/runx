{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/command/plan/v1.json",
  "x-runx-packet-id": "runx.command.plan.v1",
  "type": "object",
  "required": [
    "schema",
    "command_digest",
    "cwd",
    "timeout_ms",
    "output_mode",
    "env_names"
  ],
  "properties": {
    "schema": { "const": "runx.command.plan.v1" },
    "command_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "cwd": { "type": "string", "minLength": 1 },
    "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
    "output_mode": { "enum": ["digest", "text", "json"] },
    "env_names": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" }
    }
  },
  "additionalProperties": false
}
