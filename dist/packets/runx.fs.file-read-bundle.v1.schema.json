{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/fs/file_read_bundle/v1.json",
  "x-runx-packet-id": "runx.fs.file_read_bundle.v1",
  "type": "object",
  "required": ["repo_root", "file_count", "total_bytes", "files", "missing"],
  "properties": {
    "repo_root": { "type": "string", "minLength": 1 },
    "file_count": { "type": "integer", "minimum": 0, "maximum": 16 },
    "total_bytes": { "type": "integer", "minimum": 0, "maximum": 33554432 },
    "files": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["path", "repo_root", "contents", "bytes", "truncated", "content_digest"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "repo_root": { "type": "string", "minLength": 1 },
          "contents": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 0 },
          "truncated": { "type": "boolean" },
          "content_digest": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "missing": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
