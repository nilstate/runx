{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/payment/recovery/v1.json",
  "x-runx-packet-id": "runx.payment.recovery.v1",
  "x-runx-generated-from": "skills/spend/graph/pay-recover/X.yaml#root.runners.inspect",
  "type": "object",
  "required": [
    "open_questions",
    "proof_refs",
    "rail_lookup",
    "recommended_action",
    "recovery_assessment"
  ],
  "properties": {
    "open_questions": {
      "type": "array"
    },
    "proof_refs": {
      "type": "array"
    },
    "rail_lookup": {
      "additionalProperties": false,
      "properties": {
        "idempotency_key": {
          "minLength": 1,
          "type": "string"
        },
        "rail_profile_ref": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "idempotency_key",
        "rail_profile_ref"
      ],
      "type": "object"
    },
    "recommended_action": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "seal",
            "retry_same_key",
            "decline",
            "escalate"
          ],
          "type": "string"
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "recovery_assessment": {
      "additionalProperties": false,
      "properties": {
        "already_mutated": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string"
        },
        "status": {
          "enum": [
            "recovered",
            "retry_safe",
            "failed",
            "ambiguous"
          ],
          "type": "string"
        }
      },
      "required": [
        "status",
        "already_mutated"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false
}
