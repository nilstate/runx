{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/fetch/v1.json",
  "x-runx-packet-id": "runx.fetch.v1",
  "type": "object",
  "properties": {
    "final_url": { "type": "string" },
    "status": { "type": "number" },
    "content_digest": { "type": "string" },
    "extract_mode": { "enum": ["text", "metadata", "links"] },
    "extracted": {
      "oneOf": [
        { "type": "string" },
        { "type": "object", "additionalProperties": true },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
