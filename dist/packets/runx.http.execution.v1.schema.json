{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.runx.ai/runx/http/execution/v1.json",
  "x-runx-packet-id": "runx.http.execution.v1",
  "type": "object",
  "required": ["schema", "decision", "responses", "request_count", "stopped"],
  "properties": {
    "schema": { "const": "runx.http.execution.v1" },
    "decision": { "enum": ["completed", "stopped"] },
    "responses": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/response" }
    },
    "request_count": { "type": "integer", "minimum": 0 },
    "stopped": { "type": "boolean" }
  },
  "$defs": {
    "response": {
      "type": "object",
      "required": [
        "id",
        "performed",
        "status",
        "ok",
        "json",
        "body",
        "body_digest",
        "body_bytes",
        "truncated",
        "headers"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "performed": { "type": "boolean" },
        "status": { "type": "integer", "minimum": 0, "maximum": 599 },
        "ok": { "type": "boolean" },
        "json": {},
        "body": { "type": "string" },
        "body_digest": {
          "type": "string",
          "pattern": "^(?:|sha256:[0-9a-f]{64})$"
        },
        "body_bytes": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "skip_reason": { "type": "string" },
        "pages": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/response" }
        },
        "page_count": { "type": "integer", "minimum": 0, "maximum": 20 },
        "item_count": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "next_cursor": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
